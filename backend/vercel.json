{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "app/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,.venv/**,dist/**,build/**}"
    }
  },
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/internal/jobs",
      "schedule": "30 18 * * *"
    }
  ]
}

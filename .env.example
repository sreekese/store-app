# Local development only. Use separate credentials/secrets for deployment.
POSTGRES_USER=nearperk
POSTGRES_PASSWORD=nearperk_local
POSTGRES_DB=nearperk
POSTGRES_PORT=55432
BACKEND_PORT=8000
FRONTEND_PORT=5173
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# For running the backend outside Docker:
DATABASE_URL=postgresql+psycopg://nearperk:nearperk_local@localhost:55432/nearperk

# Generate a private signing key for deployment; the fallback is local-only.
JWT_SECRET_KEY=local-development-only-change-this-signing-key
COOKIE_SECURE=false

# Nearby discovery uses kilometres; widening the radius requires a user action.
DISCOVERY_RADIUS_KM=5
DISCOVERY_MAX_RADIUS_KM=10

# Review new/edited offers before they are public.
OFFER_MODERATION_ENABLED=true

# Validation + redemption attempts per account per 15 minutes
REDEMPTION_RATE_LIMIT=100

# Billing is off by default. Sandbox supports local/test use only; never real charges.
BILLING_PROVIDER=disabled
BILLING_WEBHOOK_SECRET=

# Production requires explicit public hosts, HTTPS CORS origins and secure cookies.
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
MAX_REQUEST_BYTES=65536
REQUEST_BODY_TIMEOUT_SECONDS=10
MUTATION_RATE_LIMIT=300

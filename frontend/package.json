{
  "name": "nearperk-frontend",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write src *.json *.ts *.js index.html",
    "format:check": "prettier --check src *.json *.ts *.js index.html"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.0",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.1",
    "vitest": "5.0.2"
  }
}
